---
import Base from '../layouts/Base.astro';
import { getVisibleHomes } from '../lib/pages';
import { localePath, type Locale } from '../i18n';

export async function getStaticPaths() {
  const homes = await getVisibleHomes();
  const alternates = homes.map((h) => ({
    locale: h.data.locale as Locale,
    path: localePath(h.data.locale as Locale),
  }));
  return homes.map((h) => ({
    // 日本語はルート(locale なし)、英語は /en/
    params: { locale: h.data.locale === 'ja' ? undefined : h.data.locale },
    props: { home: h, alternates },
  }));
}

const { home, alternates } = Astro.props;
const d = home.data;
---
<Base
  locale={d.locale}
  title={d.title}
  description={d.description}
  alternates={alternates}
  draft={d.status !== 'published'}
>
  <main class="home">
    <header class="hero">
      <h1>YummyCreate</h1>
      <p class="tagline">{d.tagline}</p>
    </header>
    <ul class="areas">
      {d.areas.map((a) => (
        <li>
          <h2>{a.name}</h2>
          <p>{a.summary}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>
