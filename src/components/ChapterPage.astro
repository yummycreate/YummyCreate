---
import Base from '../layouts/Base.astro';
import { localeLabels, localePath, type Locale } from '../i18n';
import {
  chapterPath,
  chaptersOf,
  getVisibleChapters,
  type ChapterEntry,
} from '../lib/pages';
import { render } from 'astro:content';
import readerJs from '../scripts/reader.js?raw';

interface Props {
  entry: ChapterEntry;
}

const { entry } = Astro.props;
const d = entry.data;
const locale = d.locale as Locale;
const all = await getVisibleChapters();

// 同じ本の同じ章の、出力される言語版(hreflang と言語リンク)
const alternates = all
  .filter((e) => e.data.book === d.book && e.data.chapter === d.chapter)
  .map((e) => ({
    locale: e.data.locale as Locale,
    path: chapterPath(e.data.locale as Locale, e.data.book, e.data.chapter),
  }));

const list = chaptersOf(all, locale, d.book);
const i = list.findIndex((e) => e.id === entry.id);
const prev = list[i - 1];
const next = list[i + 1];
const href = (e?: ChapterEntry) => (e ? chapterPath(locale, e.data.book, e.data.chapter) : undefined);

const { Content } = await render(entry);

const t = {
  ja: { prev: '前へ', next: '次へ', nextChapter: '次の章へ', prevChapter: '前の章', home: 'トップ', page: 'ページ' },
  en: { prev: 'Previous', next: 'Next', nextChapter: 'Next chapter', prevChapter: 'Previous chapter', home: 'Home', page: 'Page' },
}[locale];
---
<Base
  locale={locale}
  title={`${d.title} | ${d.bookTitle} | YummyCreate`}
  description={d.description}
  alternates={alternates}
  draft={d.status !== 'published'}
  noindex={d.noindex}
  hideFooter
>
  <div class="reader" data-reader data-next-chapter={href(next)} data-prev-chapter={href(prev)}>
    <header class="reader-head">
      <a href={localePath(locale)}>{t.home}</a>
      <span class="reader-book">{d.bookTitle}</span>
      <nav aria-label="Language">
        {alternates.filter((a) => a.locale !== locale).map((a) => (
          <a href={a.path} hreflang={a.locale} lang={a.locale}>{localeLabels[a.locale]}</a>
        ))}
      </nav>
    </header>

    <div class="reader-frame">
    <div class="reader-fold" data-fold aria-hidden="true"></div>
    <div class="reader-viewport" data-viewport tabindex="0">
      <article class="reader-body" data-body>
        <h1>{d.title}</h1>
        <Content />
        <nav class="chapter-links" aria-label="Chapters">
          {prev && <a href={href(prev)}>← {t.prevChapter}: {prev.data.title}</a>}
          {next && <a href={href(next)}>{t.nextChapter}: {next.data.title} →</a>}
        </nav>
      </article>
      <div class="reader-snaps" data-snaps aria-hidden="true"></div>
    </div>
    </div>

    <footer class="reader-controls" data-controls hidden>
      <button type="button" data-prev>{t.prev}</button>
      <span class="reader-count" aria-live="polite"><span data-current>1</span> / <span data-total>1</span></span>
      <button type="button" data-next data-label-next={t.next} data-label-chapter={t.nextChapter}>{t.next}</button>
    </footer>
  </div>
</Base>

<script is:inline set:html={readerJs}></script>
