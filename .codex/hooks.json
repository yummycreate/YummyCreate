{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/stop-require-merge.mjs\" --tool codex",
            "timeout": 60,
            "statusMessage": "PRのマージ状態を確認中"
          }
        ]
      }
    ]
  }
}
